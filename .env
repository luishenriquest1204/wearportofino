# PORTOFINO — public, non-secret build settings. NEVER put API keys, tokens or passwords here:
# every VITE_ variable is compiled into the public JavaScript.

# Commercial state: "prelaunch" (default, no sales) or "live" (official operation).
# Anything other than exactly "live" is treated as pre-launch.
VITE_STORE_MODE=prelaunch

# Public site (the admin is excluded from this build).
VITE_INCLUDE_ADMIN=false

# "hash" works on any static host. Switch to "browser" (clean URLs, better SEO) once the host
# rewrites every path to index.html.
VITE_ROUTER=hash

# Fill in before publishing on the official domain (see docs/OFFICIAL-LAUNCH-PROTOCOL.md).
VITE_SITE_URL=
VITE_INSTAGRAM_URL=
VITE_CONTACT_EMAIL=
VITE_NEWSLETTER_ENDPOINT=
